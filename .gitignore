**/.DS_Store
# Binaries built in the root. These are anchored so that the cmd/vsql-cli
# source directory isn't ignored.
/vsql-cli
/vsql-server
*.vsql
*.vsql.session
*.vsql.wal
.vscode
.vlang_tmp_build/
scripts/generate-v-client-library-docs
scripts/generate-grammar
y.output
vsql/y.y

# Temporary build directories created by the V3 compiler.
.*.v3cc.*

# The SQL standard documents are copyrighted and must never be committed.
standard_docs/

# Test binaries left behind by V3, such as vsql/sql_test.
vsql/*_test

# Created by make sql-test.
coverage/

# Created by make release.
vsql-*.zip

# Created by "make module-example" and "make module-test".
libvsql/module/example.[ch]
libvsql/module/test.[ch]
libvsql/module/test_other.[ch]

# Created by "make embed-example".
libvsql/embed/example.c
