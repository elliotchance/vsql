/*
 * test.sqc tests the C that "vsql precompile" generates. Run it with
 * "make embed-test".
 */

#include <stdio.h>
#include <string.h>

static int failures = 0;

#define CHECK(condition)                                                       \
  do {                                                                         \
    if (!(condition)) {                                                        \
      fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #condition);          \
      failures++;                                                              \
    }                                                                          \
  } while (0)

int main(void) {
  EXEC SQL BEGIN DECLARE SECTION;
  char SQLSTATE[6];
  long x;
  long x_indicator;
  long long b;
  /* A BINARY is an unsigned char array, and a VARBINARY is a struct with a
   * length (each name has its own struct). */
  SQL TYPE IS BINARY(3) bin3;
  SQL TYPE IS VARBINARY(4) vb, vb2 = {0, 2, {1, 2}};
  long vb_indicator;
  /* A CLOB and a BLOB are structs with a length (in characters for a CLOB,
   * whose data has 4 octets for each character). */
  SQL TYPE IS CLOB(3) clob3;
  SQL TYPE IS BLOB(4) blob4, blob4b = {0, 2, {7, 0}};
  EXEC SQL END DECLARE SECTION;

  EXEC SQL CONNECT TO ':memory:' AS 'test';
  EXEC SQL CREATE TABLE widths (x INTEGER, b BIGINT);
  CHECK(strcmp(SQLSTATE, "00000") == 0);

  /*
   * A long host variable is an INTEGER, and long can be wider than an
   * SQLINTEGER. All of it is set, whatever it held before and whatever the sign
   * is.
   */
  x = 1;
  b = 10;
  EXEC SQL INSERT INTO widths (x, b) VALUES (:x, :b);
  CHECK(strcmp(SQLSTATE, "00000") == 0);
  x = -5;
  b = 20;
  EXEC SQL INSERT INTO widths (x, b) VALUES (:x, :b);
  CHECK(strcmp(SQLSTATE, "00000") == 0);

  x = -1;
  EXEC SQL SELECT x INTO :x FROM widths WHERE b = 10;
  CHECK(strcmp(SQLSTATE, "00000") == 0);
  CHECK(x == 1);
  x = 0;
  EXEC SQL SELECT x INTO :x FROM widths WHERE b = 20;
  CHECK(strcmp(SQLSTATE, "00000") == 0);
  CHECK(x == -5);

  EXEC SQL DECLARE c CURSOR FOR SELECT x FROM widths WHERE b = :b;
  x = -1;
  b = 10;
  EXEC SQL OPEN c;
  EXEC SQL FETCH c INTO :x;
  CHECK(strcmp(SQLSTATE, "00000") == 0);
  CHECK(x == 1);
  EXEC SQL CLOSE c;
  x = 0;
  b = 20;
  EXEC SQL OPEN c;
  EXEC SQL FETCH c INTO :x;
  CHECK(strcmp(SQLSTATE, "00000") == 0);
  CHECK(x == -5);
  EXEC SQL CLOSE c;

  /* A null value leaves the variable alone. */
  EXEC SQL INSERT INTO widths (b) VALUES (30);
  x = 7;
  x_indicator = 0;
  EXEC SQL SELECT x INTO :x INDICATOR :x_indicator FROM widths WHERE b = 30;
  CHECK(strcmp(SQLSTATE, "00000") == 0);
  CHECK(x == 7);
  CHECK(x_indicator == -1);

  /* A value out of range of INTEGER doesn't fit, even if it fits the long. */
  EXEC SQL INSERT INTO widths (b) VALUES (8589934592);
  EXEC SQL SELECT b INTO :x FROM widths WHERE b = 8589934592;
  CHECK(strcmp(SQLSTATE, "22003") == 0);
  CHECK(x == 7);
  /* This can't be an #if, because the function of the statement would be
   * unused where a long is 32 bits, such as on Windows. */
  if (sizeof(long) > 4) {
    x = (long)(1LL << 40);
    b = 40;
    EXEC SQL INSERT INTO widths (x, b) VALUES (:x, :b);
    CHECK(strcmp(SQLSTATE, "22003") == 0);
  }

  /* Binary strings. */
  EXEC SQL CREATE TABLE binaries (x INTEGER, bin3 BINARY(3), vb VARBINARY(4));
  memcpy(bin3, "\x00\xab\x00", 3);
  x = 1;
  EXEC SQL INSERT INTO binaries (x, bin3, vb) VALUES (:x, :bin3, :vb2);
  CHECK(strcmp(SQLSTATE, "00000") == 0);
  memset(bin3, 9, sizeof(bin3));
  vb.vb_length = 9;
  EXEC SQL SELECT bin3, vb INTO :bin3, :vb :vb_indicator FROM binaries
    WHERE x = 1;
  CHECK(strcmp(SQLSTATE, "00000") == 0);
  CHECK(memcmp(bin3, "\x00\xab\x00", 3) == 0);
  CHECK(vb.vb_length == 2);
  CHECK(memcmp(vb.vb_data, "\x01\x02", 2) == 0);
  CHECK(vb_indicator == 0);

  /* Large objects. */
  EXEC SQL CREATE TABLE lobs (x INTEGER, c CLOB(10), b BLOB(10));
  /* The octets after the 2 characters look like part of a character, which
   * must not be sent. */
  memset(clob3.clob3_data, 0xa9, sizeof(clob3.clob3_data));
  memcpy(clob3.clob3_data, "a\xc3\xa9", 3);
  clob3.clob3_length = 2;
  EXEC SQL INSERT INTO lobs (x, c, b) VALUES (1, :clob3, :blob4b);
  CHECK(strcmp(SQLSTATE, "00000") == 0);
  memset(&clob3, 9, sizeof(clob3));
  memset(&blob4, 9, sizeof(blob4));
  EXEC SQL SELECT c, b INTO :clob3, :blob4 FROM lobs WHERE x = 1;
  CHECK(strcmp(SQLSTATE, "00000") == 0);
  CHECK(clob3.clob3_length == 2);
  CHECK(memcmp(clob3.clob3_data, "a\xc3\xa9", 3) == 0);
  CHECK(sizeof(clob3.clob3_data) == 12);
  CHECK(blob4.blob4_length == 2);
  CHECK(memcmp(blob4.blob4_data, "\x07\x00", 2) == 0);

  EXEC SQL ROLLBACK;
  EXEC SQL DISCONNECT ALL;

  if (failures > 0) {
    return 1;
  }
  printf("OK\n");
  return 0;
}
