#!/usr/bin/env -S v

// generate-keywords-docs.vsh replaces the lists of key words at the end of
// docs/keywords.rst (everything after the marker line) with the ones of the
// grammar, so that they are always the same as the parser.
//
// Run from the repo root: $ make snippets
//
// The reserved words are vsql.reserved_words(), which the lexer uses. The
// non-reserved words are those of the non_reserved_word rule (the same rule
// that reserved_words() reads), less the key words of vsql extensions, which
// are listed separately.
import os
import vsql

const path = 'docs/keywords.rst'
const marker = '.. The lists below are generated by scripts/generate-keywords-docs.vsh.'

fn main() {
	text := os.read_file(path)!
	if !text.contains(marker) {
		eprintln('${path} has no line: ${marker}')
		exit(1)
	}

	extensions := vsql.extension_keywords()

	grammar := os.read_file('vsql/std_2_5_2_token_and_separator.y')!
	mut non_reserved := []string{}
	for line in grammar.all_after('\nnon_reserved_word:\n').all_before('\n\n').split_into_lines() {
		// A word can have a precedence, such as "IF %prec IF_WORD".
		name := line.trim_left('| ').all_before('%prec').trim_space()
		if name !in extensions {
			non_reserved << name
		}
	}
	non_reserved.sort()

	mut out := text.all_before(marker) + marker + '\n\n'
	out += section('Reserved Words', vsql.reserved_words())
	out += section('Non-reserved Words', non_reserved)
	out += section('Extension Key Words', extensions)

	os.write_file(path, out.trim_right('\n') + '\n')!
}

fn section(title string, words []string) string {
	mut s := '${title}\n${'-'.repeat(title.len)}\n\n.. hlist::\n   :columns: 4\n\n'
	for word in words {
		s += '   * ``${word}``\n'
	}

	return s + '\n'
}
