%%

// ISO/IEC 9075-2:2023, 11.20, <alter identity column specification>, Conformance Rules, 1 to 3
alter_identity_column_specification:
  alter_identity_column_options {
    flag(mut yylex, 'T174')
    $$.v = yy_box(AlterIdentityColumnSpecification{options: $1.v as []SequenceGeneratorOption})
  }
| set_identity_column_generation_clause {
    flag(mut yylex, 'T174')
    flag(mut yylex, 'F386')
    $$.v = yy_box(AlterIdentityColumnSpecification{always: $1.v as bool})
  }
| set_identity_column_generation_clause alter_identity_column_options {
    flag(mut yylex, 'T174')
    flag(mut yylex, 'F386')
    $$.v = yy_box(AlterIdentityColumnSpecification{
      always:  $1.v as bool
      options: $2.v as []SequenceGeneratorOption
    })
  }

// The value is true for ALWAYS and false for BY DEFAULT.
set_identity_column_generation_clause:
  SET GENERATED ALWAYS { $$.v = true }
| SET GENERATED BY DEFAULT { $$.v = false }

alter_identity_column_options:
  alter_identity_column_option { $$.v = yy_box([$1.v as SequenceGeneratorOption]) }
| alter_identity_column_options alter_identity_column_option {
    $$.v = yy_box(append_list($1.v as []SequenceGeneratorOption,
      $2.v as SequenceGeneratorOption))
  }

alter_identity_column_option:
  alter_sequence_generator_restart_option {
    flag_if(mut yylex, ($1.v as SequenceGeneratorRestartOption).restart_value == none,
      'T178')
    $$.v = yy_box(SequenceGeneratorOption($1.v as SequenceGeneratorRestartOption))
  }
| SET basic_sequence_generator_option {
    $$.v = $2.v
  }

%%
