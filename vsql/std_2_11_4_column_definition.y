%%

// ISO/IEC 9075-2:2023, 11.4, <column definition>
//
// Define a column of a base table.

// The column is the first element, and each <column constraint> adds a table
// constraint (see add_column_constraint), followed by its <constraint
// characteristics>.
column_definition:
  column_name data_type_or_domain_name {
    $$.v = yy_box([TableElement(Column{name: $1.v as Identifier, typ: $2.v as Type})])
  }
| column_name data_type_or_domain_name default_clause {
    $$.v = yy_box([
      TableElement(Column{
        name:          $1.v as Identifier
        typ:           $2.v as Type
        default_value: new_ref($3.v as DefaultOption)
      }),
    ])
  }
| column_name data_type_or_domain_name identity_column_specification {
    flag(mut yylex, 'T174')
    $$.v = yy_box([
      TableElement(Column{
        name:     $1.v as Identifier
        typ:      $2.v as Type
        identity: new_ref($3.v as IdentityColumn)
      }),
    ])
  }
| column_name data_type_or_domain_name generation_clause {
    flag(mut yylex, 'T175')
    $$.v = yy_box([
      TableElement(Column{
        name:      $1.v as Identifier
        typ:       $2.v as Type
        generated: new_ref($3.v as GenerationClause)
      }),
    ])
  }
| column_name generation_clause {
    flag(mut yylex, 'T175')
    $$.v = yy_box([
      TableElement(Column{
        name:      $1.v as Identifier
        generated: new_ref(GenerationClause{
          ...$2.v as GenerationClause
          infer_type: true
        })
      }),
    ])
  }
| column_definition column_constraint_definition {
    $$.v = yy_box(add_column_constraint($1.v as []TableElement, $2.v as ColumnConstraint))
  }
| column_definition constraint_characteristic {
    $$.v = yy_box(with_constraint_characteristic($1.v as []TableElement, $2.v as string)!)
  }

data_type_or_domain_name:
  data_type { $$.v = $1.v }

column_constraint_definition:
  column_constraint { $$.v = $1.v }
| constraint_name_definition NOT NULL {
    $$.v = yy_box(ColumnConstraint(NotNullConstraint{name: $1.v as Identifier}))
  }
| constraint_name_definition unique_specification {
    $$.v = yy_box(ColumnConstraint(UniqueConstraintDefinition{
      name:           $1.v as Identifier
      is_primary_key: $2.v as bool
    }))
  }
| constraint_name_definition references_specification {
    $$.v = yy_box(ColumnConstraint(ReferentialConstraintDefinition{
      ...$2.v as ReferentialConstraintDefinition
      name: $1.v as Identifier
    }))
  }
| constraint_name_definition check_constraint_definition {
    $$.v = yy_box(ColumnConstraint(CheckConstraintDefinition{
      ...$2.v as CheckConstraintDefinition
      name: $1.v as Identifier
    }))
  }

column_constraint:
  NOT NULL { $$.v = yy_box(ColumnConstraint(NotNullConstraint{})) }
| unique_specification {
    $$.v = yy_box(ColumnConstraint(UniqueConstraintDefinition{is_primary_key: $1.v as bool}))
  }
| references_specification {
    $$.v = yy_box(ColumnConstraint($1.v as ReferentialConstraintDefinition))
  }
| check_constraint_definition {
    $$.v = yy_box(ColumnConstraint($1.v as CheckConstraintDefinition))
  }

identity_column_specification:
  GENERATED ALWAYS AS IDENTITY { $$.v = yy_box(IdentityColumn{always: true}) }
| GENERATED ALWAYS AS IDENTITY left_paren common_sequence_generator_options
  right_paren {
    $$.v = yy_box(IdentityColumn{
      always:  true
      options: $6.v as []SequenceGeneratorOption
    })
  }
| GENERATED BY DEFAULT AS IDENTITY { $$.v = yy_box(IdentityColumn{}) }
| GENERATED BY DEFAULT AS IDENTITY left_paren common_sequence_generator_options
  right_paren {
    $$.v = yy_box(IdentityColumn{
      options: $7.v as []SequenceGeneratorOption
    })
  }

// The <generation rule> (GENERATED ALWAYS) isn't its own rule, otherwise it
// would conflict with the <identity column specification>.
generation_clause:
  GENERATED ALWAYS AS generation_expression {
    $$.v = yy_box(GenerationClause{expr: $4.v as ValueExpression})
  }

generation_expression:
  left_paren value_expression right_paren { $$.v = $2.v }

%%
